{
  "expo": {
    "name": "Norov",
    "slug": "sklad",
    "version": "1.0.6",
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "experiments": {
      "tsconfigPaths": true
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#ffffff",
          "sounds": []
        }
      ],
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": false,
          "modes": [],
          "bluetoothAlwaysPermission": "Bluetooth используется для подключения к принтеру этикеток (XPrinter)."
        }
      ]
    ],
    "orientation": "default",
    "notification": {
      "icon": "./assets/icon.png",
      "color": "#ffffff"
    },
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.umed1.sklad",
      "infoPlist": {
        "NSBluetoothAlwaysUsageDescription": "Bluetooth используется для подключения к принтеру этикеток (только Android — iOS не поддерживает Bluetooth Classic для принтеров XPrinter)."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.umed1.sklad",
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "NOTIFICATIONS",
        "BLUETOOTH",
        "BLUETOOTH_ADMIN",
        "BLUETOOTH_SCAN",
        "BLUETOOTH_CONNECT",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "extra": {
      "eas": {
        "projectId": "a8b23124-dac2-49fe-9d0c-fc62754bda89"
      }
    }
  }
}